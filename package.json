{
  "name": "dsh-pi-host",
  "version": "0.1.0-rc.1",
  "description": "Run Pi extensions as agent-scoped DeepSeek Harness plugins",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "pi-extension",
    "ai-agents"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TGYD-helige/dsh-pi.git"
  },
  "homepage": "https://github.com/TGYD-helige/dsh-pi#readme",
  "bugs": {
    "url": "https://github.com/TGYD-helige/dsh-pi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./compatibility": {
      "types": "./lib/compatibility.d.ts",
      "default": "./lib/compatibility.js"
    },
    "./capabilities": {
      "types": "./lib/capabilities.d.ts",
      "default": "./lib/capabilities.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm test && pnpm typecheck && pnpm build",
    "compat": "tsx scripts/compat.ts",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@earendil-works/pi-coding-agent": ">=0.80.10 <0.81"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
